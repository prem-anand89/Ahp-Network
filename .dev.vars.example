# Copy to .dev.vars and fill in for local development.
# Never commit .dev.vars itself — it's gitignored.

# Local Postgres connection string, used to emulate the HYPERDRIVE binding
# during `next dev`/`next build`. Point this at a local Postgres instance,
# never the real Supabase project — see CLAUDE.md's hosting section for why
# Hyperdrive's origin (production) and this local string (dev) must both be
# session-mode, not transaction-mode, pooled connections.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgres://postgres:localdev@127.0.0.1:5432/ahp_network_dev

# Supabase Auth (§4) — URL and anon key are public by design (safe to see
# in the browser), get these from the Supabase dashboard's API settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Gates src/app/(dev)/design, the internal design-system review route.
# Set to "1" locally to see it; never set on the production Worker.
NEXT_PUBLIC_DESIGN_ROUTE=1

# The ahp-network-photos R2 bucket's PUBLIC url (its r2.dev subdomain, or
# a real custom domain once one exists) — never the private S3-API
# endpoint used for presigning. Requires enabling public access on that
# bucket in the Cloudflare dashboard first; see r2.ts's publicPhotoUrl
# comment. Leave blank locally if that hasn't been set up yet — photo
# upload still works, the stored photoUrl just won't resolve to an image.
NEXT_PUBLIC_PHOTOS_BASE_URL=

# Reveal-contact's Turnstile widget (src/components/reveal-contact-button.tsx,
# src/lib/turnstile.ts). Create a widget in the Cloudflare dashboard
# (Turnstile -> Add a site), with "localhost" as one of its hostnames for
# local dev. Site key here is public/safe to commit if you're editing
# wrangler.jsonc's real value; the secret key below is NOT — it stays out
# of every committed file, set only in .dev.vars locally and via
# `wrangler secret put TURNSTILE_SECRET_KEY` for deployed environments.
# Leave both blank locally to skip verification entirely — reveal-contact.ts
# only enforces it when TURNSTILE_SECRET_KEY is actually set (see its
# header comment); the rate limits alone still apply either way.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
