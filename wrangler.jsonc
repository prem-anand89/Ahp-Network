{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Not `.open-next/worker.js` directly — worker.js wraps it to add the
	// `scheduled` handler the Cron Triggers below need, and delegates every
	// fetch straight through. See worker.js for why it is not TypeScript.
	"main": "worker.js",
	"name": "ahp-network",
	"compatibility_date": "2026-09-03",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "ahp-network"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	"r2_buckets": [
		// Use R2 incremental cache
		// See https://opennext.js.org/cloudflare/caching
		{
			"binding": "NEXT_INC_CACHE_R2_BUCKET",
			"bucket_name": "ahp-network-opennext-cache"
		}
	],
	"hyperdrive": [
		{
			// One connection path for every query — see db.ts. Origin must be
			// Supabase's SESSION-mode pooler (port 5432), never transaction-mode
			// (6543) — see spike/README.md for why stacking Hyperdrive on another
			// transaction-mode pooler breaks every connection regardless of load.
			"binding": "HYPERDRIVE",
			"id": "788ce466573445f9aeac98d779e84774"
		}
	],
	// Cron Triggers — the referral engine's clock. These moved off GitHub
	// Actions schedules, which GitHub does not guarantee and throttles
	// hard: a `*/5` workflow in this repo was measured firing every 2-4
	// HOURS, leaving the outbox worker and scheduler heartbeats over an
	// hour stale. That breaks §8D's sub-hourly requirement outright — a
	// 2-hour urgent-referral window cannot be serviced by a job that runs
	// every few hours.
	//
	// Each expression must match a key in src/lib/cron-routes.ts character
	// for character (Cloudflare passes it through as `controller.cron` and
	// worker.js looks it up by exact string). CI's
	// check-cron-triggers-wired.mjs fails if the two ever drift.
	//
	// Budget: Cloudflare allows 5 Cron Triggers per ACCOUNT on the free
	// plan (250 on paid). These five use all of it, which is why the
	// liveness check stays on GitHub Actions — it also *should* stay
	// external, since a monitor inside the Worker cannot report the Worker
	// being down. Adding a sixth job here needs Workers Paid.
	"triggers": {
		"crons": [
			"*/2 * * * *", // notification outbox worker
			"*/15 * * * *", // referral deadline scheduler
			"0 * * * *", // hourly cost check
			"0 3 * * *", // daily retention/purge, 03:00 UTC (~8:30am IST)
			"0 4 * * 1" // weekly digest, Monday 04:00 UTC (~9:30am IST)
		]
	},
	// Supabase Auth (§4) — URL and anon key are public by design, safe as
	// plain vars (never secrets). NEXT_PUBLIC_SITE_URL must be the real
	// deployed origin so the OAuth callback redirect lands correctly — this
	// placeholder needs updating once a real domain/subdomain is decided.
	// NEXT_PUBLIC_VAPID_PUBLIC_KEY (Phase 7, §8G4) is a VAPID public key —
	// public by design, the browser needs it for pushManager.subscribe().
	// The matching PRIVATE key is a Workers Secret, never here.
	// NEXT_PUBLIC_SENTRY_DSN — a Sentry DSN is meant to be public (it's
	// baked into the client bundle so the browser can report errors); the
	// project/org-level auth that actually protects the account is
	// separate. Listed here to match this file's own documentation
	// convention, but what next build actually inlines into the deployed
	// bundle comes from wherever that build ran — see
	// src/instrumentation-client.ts, the only place this is read.
	// Found the hard way: Cloudflare's Workers Builds Git integration has
	// separate build-time and runtime variable sections, and this value
	// must be in the BUILD one — a NEXT_PUBLIC_ var only in the runtime
	// section never reaches the `next build` step that inlines it, so the
	// deployed bundle silently ships with an undefined DSN and Sentry
	// initializes disabled, no error, nothing ever sent.
	// Deliberately @sentry/browser there, not @sentry/nextjs: the latter
	// pulls in @opentelemetry/api, which broke OpenNext's Cloudflare build
	// (its Node.js-middleware vendoring can't bundle that package's ESM
	// subtree) — a build-breaking failure, not a runtime one, caught by a
	// full local `opennextjs-cloudflare build` before this ever shipped.
	"vars": {
		"NEXT_PUBLIC_SUPABASE_URL": "https://nbwuiynmgmnkvkdwioux.supabase.co",
		"NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im5id3VpeW5tZ21ua3ZrZHdpb3V4Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODgzNDIzMzIsImV4cCI6MjEwMzkxODMzMn0.AJhbYERUEQuQ2Iv3o1mU05kIWlZCeQ8cMmhkj-tFEm8",
		"NEXT_PUBLIC_SENTRY_DSN": "https://83d4d146ef505ada4c92701a585e92e1@o4512033909047296.ingest.de.sentry.io/4512057227280464",
		"NEXT_PUBLIC_SITE_URL": "https://ahp-network.theranetconnect.workers.dev",
		"NEXT_PUBLIC_VAPID_PUBLIC_KEY": "BArzPk1dk4s-AG3v-ZOr7_b6EhzTENbtqr8oSeTIDQA-wqv4-0VY_RWo1unmSslpNExhMMIoKSluezkamawZRs4"
	},
	// Staging: a distinct Worker (`ahp-network-staging`) deployed via
	// `wrangler deploy --env staging`, with its own Supabase project
	// (`gkgijnzqphppudpxcifg`) and Hyperdrive config (`ahp-network-staging-db`).
	// The Hyperdrive ID below is patched at deploy time by deploy-staging.yml
	// if `scripts/ensure-staging-hyperdrive.mjs` returns a different ID.
	"env": {
		"staging": {
			"name": "ahp-network-staging",
			// Explicitly none, not inherited. `triggers` is an inheritable key,
			// so without this staging would pick up production's five schedules:
			// it would run the referral engine's jobs against the staging
			// database on its own, and the account-wide Cron Trigger budget is 5
			// on the free plan, which those five already use in full.
			"triggers": {
				"crons": []
			},
			"images": {
				"binding": "IMAGES"
			},
			"services": [
				{
					"binding": "WORKER_SELF_REFERENCE",
					"service": "ahp-network-staging"
				}
			],
			"r2_buckets": [
				{
					"binding": "NEXT_INC_CACHE_R2_BUCKET",
					"bucket_name": "ahp-network-staging-opennext-cache"
				}
			],
			"hyperdrive": [
				{
					"binding": "HYPERDRIVE",
					"id": "00000000000000000000000000000000"
				}
			],
			"vars": {
				"NEXT_PUBLIC_SUPABASE_URL": "https://gkgijnzqphppudpxcifg.supabase.co",
				"NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImdrZ2lqbnpxcGhwcHVkcHhjaWZnIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODg2MTA0MTAsImV4cCI6MjEwNDE4NjQxMH0.NRGY-0m4RaH9eH0KrFXb1kEPTYNaea4IAqy-oPwQVEQ",
				"NEXT_PUBLIC_SITE_URL": "https://ahp-network-staging.theranetconnect.workers.dev",
				"NEXT_PUBLIC_VAPID_PUBLIC_KEY": "BArzPk1dk4s-AG3v-ZOr7_b6EhzTENbtqr8oSeTIDQA-wqv4-0VY_RWo1unmSslpNExhMMIoKSluezkamawZRs4"
			}
		}
	}
}
